# ============================================================================
# Harvest3 環境変数設定ファイル（テンプレート）
# 最終更新: 2025-07-13 (Issue #206対応)
# ============================================================================

# ============================================================================
# 基本システム設定
# ============================================================================

# 実行環境 (development, production, test)
NODE_ENV=development

# Webサーバーポート
PORT=3000

# ログレベル設定
LOG_LEVEL=info
HFT_LOG_LEVEL=info

# リアルタイム機能の有効化
ENABLE_REALTIME=true

# バックテストモード
BACKTEST_MODE=false

# CI環境フラグ
CI=false
DEBUG_CI_ERRORS=false

# ============================================================================
# 取引所API設定
# ============================================================================

# Bitbank API設定
BB_API_KEY=x
BB_API_SECRET=x
BITBANK_API_KEY=x
BITBANK_API_SECRET=x

# BitFlyer API設定
BF_API_KEY=x
BF_API_SECRET=x

# 取引所レート制限設定
BITFLYER_RATE_LIMIT=1000
BITBANK_RATE_LIMIT=1000

# ============================================================================
# データベース設定
# ============================================================================

# Redis設定
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_BALANCE_KEY=balance_summary

# Redis詳細設定
REDIS_RECONNECT_DELAY=1000
REDIS_MAX_RETRY_ATTEMPTS=5
REDIS_RETRY_DELAY_MAX=3000
REDIS_CONNECTION_TIMEOUT=3600000
REDIS_RECONNECTION_INTERVAL=5000

# MongoDB設定
MONGO_URL=mongodb://mongodb:27017
MONGODB_URL=mongodb://mongodb:27017
MONGO_DB_NAME=harvest3
MONGODB_DB_NAME=harvest3

# MongoDB詳細設定
MONGODB_SERVER_SELECTION_TIMEOUT=30000
MONGODB_CONNECT_TIMEOUT=15000
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME=30000
MONGODB_HEARTBEAT_FREQUENCY=10000
MONGODB_MAX_CONNECTING=5

# ============================================================================
# 戦略有効化設定
# ============================================================================

# 基本戦略
STRATEGY_HIGH_FREQUENCY_ENABLED=false
STRATEGY_TREND_FOLLOWING_ENABLED=true
STRATEGY_MEAN_REVERSION_ENABLED=true
STRATEGY_ARBITRAGE_ENABLED=false

# 指標戦略
STRATEGY_MA_ENABLED=true
STRATEGY_MACD_ENABLED=true
STRATEGY_RSI_ENABLED=true
STRATEGY_BOLLINGER_BANDS_ENABLED=true
STRATEGY_OSCILLATOR_ENABLED=true
STRATEGY_SCALPING_ENABLED=false

# 高度戦略
STRATEGY_MARKET_MAKING_ENABLED=false
STRATEGY_MULTI_INDICATOR_ENABLED=false
STRATEGY_HFT_ENABLED=false
STRATEGY_HFT_BB_WS_ENABLED=false
STRATEGY_INYO_ENABLED=false

# ============================================================================
# API制限・スロットリング設定
# ============================================================================

# 基本API設定
API_TIMEOUT=60000
EXCHANGE_RATE_LIMIT=15000
EXCHANGE_TIMEOUT=60000
EXCHANGE_MAX_THROTTLE_QUEUE_SIZE=5000
EXCHANGE_MAX_CONCURRENT_PAIRS=1
EXCHANGE_EXECUTION_DELAY_MS=5000

# 再試行設定
MAX_RETRIES=3
RETRY_DELAY=1000

# ============================================================================
# 監視・バランスチェック設定
# ============================================================================

# バランス監視設定
BALANCE_CHECK_INTERVAL=300000
BALANCE_CHECK_TIMEOUT=30000
BALANCE_THRESHOLD=0.01
BALANCE_LOG_FILE=./logs/balance.log
BALANCE_ALERT_LOG=./logs/balance_alerts.log
BALANCE_MAX_LOG_LINES=10000
BALANCE_CURRENCY=BTC
BALANCE_EXCHANGE=bitbank
BALANCE_DEBUG=false

# バランスチェッカー詳細設定
BALANCE_CHECKER_SIGNIFICANT_THRESHOLD=0.001
BALANCE_CHECKER_HIGH_DISCREPANCY_PERCENT=1.0
BALANCE_CHECKER_LOCK_TTL=30000
BALANCE_CHECKER_LIGHTWEIGHT_INTERVAL=60000
BALANCE_CHECKER_ROBUST_INTERVAL=300000
BALANCE_CHECKER_DEBUG=false

# システム監視設定
MAX_CONSECUTIVE_FAILURES=3
FAILURE_ALERT_THRESHOLD=5
COMPREHENSIVE_CLEANUP_INTERVAL=600000
SELF_HEALING_INTERVAL=1800000
TASK_WAIT_INTERVAL=100

# ============================================================================
# リスク管理設定
# ============================================================================

# ストップロス設定
FIXED_STOP_LOSS_PERCENT=0.02
TRAILING_STOP_TRIGGER_PERCENT=0.01
DEFAULT_STOP_LOSS_PERCENT=0.02
TIME_BASED_STOP_HOURS=24

# 損失制限設定
DAILY_MAX_LOSS_PERCENT=0.05
WEEKLY_MAX_LOSS_PERCENT=0.10
MONTHLY_MAX_LOSS_PERCENT=0.15
MAX_DAILY_LOSS_PERCENT=0.10

# ポジション制限
MAX_POSITION_SIZE_PERCENT=0.05
SIGNIFICANT_PRICE_INCREASE_THRESHOLD=1.0

# ============================================================================
# パフォーマンス・最適化設定
# ============================================================================

# 分析期間設定
PERFORMANCE_LOOKBACK_DAYS=30

# バックテスト動的期間設定
BACKTEST_BUFFER_PERCENT=0.3

# 計算時間制限
MAX_CALCULATION_TIME=5000
OPTIMIZATION_INTERVAL=86400000

# A/Bテスト設定
AB_TEST_DURATION=604800000

# ============================================================================
# WebSocket・HFT設定
# ============================================================================

# WebSocket接続設定
WS_RECONNECTION_ATTEMPTS=5
WS_RECONNECTION_DELAY=1000
WS_TIMEOUT=10000

# WebSocketエンドポイント
WS_PUBLIC_ENDPOINT=wss://stream.bitbank.cc
WS_PRIVATE_ENDPOINT=wss://private-ws.bitbank.cc

# HFT戦略パラメータ
HFT_PRICE_THRESHOLD=0.001
HFT_ORDER_BOOK_DEPTH=15
HFT_EVALUATION_INTERVAL=100
HFT_TRADE_PERCENTAGE=0.001

# ============================================================================
# 取引設定
# ============================================================================

# 取引ペア・通貨設定
TRADING_PAIRS=btc_jpy,xrp_jpy,eth_jpy
IMPORTANT_CURRENCIES=BTC,ETH,XRP,LTC,BCH

# Iceberg注文しきい値
ICEBERG_THRESHOLD_BTC=0.1
ICEBERG_THRESHOLD_ETH=1.0
ICEBERG_THRESHOLD_DEFAULT=10.0

# 注文管理設定
DEFAULT_SLIPPAGE_TOLERANCE=0.005
ORDER_TIMEOUT=60000
ORDER_MAX_RETRIES=3
ORDER_RETRY_DELAY=1000
POSITION_TIMEOUT_HOURS=24

# ============================================================================
# 戦略パラメータ設定
# ============================================================================

# RSI設定
RSI_OVERSOLD_THRESHOLD=30
RSI_OVERBOUGHT_THRESHOLD=70

# ボリンジャーバンド設定
BOLLINGER_BAND_PERIOD=20
BOLLINGER_BAND_DEVIATION=2.0

# その他指標設定
VOLUME_THRESHOLD_MULTIPLIER=1.5
MOMENTUM_LOOKBACK_PERIODS=14

# ============================================================================
# データ収集・監視設定
# ============================================================================

# データ収集設定
COLLECTION_INTERVAL=60000
DATA_RETENTION_DAYS=30
DATA_DIR=./data
MAX_FILE_SIZE_MB=100
BACKUP_INTERVAL_HOURS=24

# API詳細設定
EXCHANGE_API_TIMEOUT=10000
EXCHANGE_MAX_RETRIES=3
EXCHANGE_RETRY_DELAY=1000
EXCHANGE_BACKOFF_MULTIPLIER=2

# エラー閾値設定
ERROR_THRESHOLD_WARNING=0.1
ERROR_THRESHOLD_CRITICAL=0.3

# 監視機能設定
MONITORING_ENABLED=true
ALERTS_ENABLED=true
METRICS_RETENTION_COUNT=1000

# セキュリティ設定
ENABLE_ENCRYPTION=false
LOG_SENSITIVE_DATA=false
API_KEY_MASK_LENGTH=4

# 負荷テスト設定
LOAD_TEST_ENABLED=false
LOAD_TEST_DURATION_MIN=5
LOAD_TEST_TARGET_POINTS=1000

# 有効取引所リスト
ENABLED_EXCHANGES=binance,bybit,okx

# ============================================================================
# 通知設定
# ============================================================================

# Discord Webhook URLs
DISCORD_ERROR_WEBHOOK_URL=x
DISCORD_ORDER_WEBHOOK_URL=x
DISCORD_RESULT_WEBHOOK_URL=x
DISCORD_WEB_WEBHOOK_URL=
DISCORD_WARNING_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Discord通知レートリミット設定
DISCORD_RATE_LIMIT_BUFFER_MS=1000

# ============================================================================
# セキュリティ・緊急対応設定
# ============================================================================

# 緊急対応設定
# WARNING: These variables control dangerous operations that can delete trading data
# Only set these in true emergency situations with full understanding of consequences

# Emergency phantom position deletion (scripts/forcefulSynchronizationPlan.js)
EMERGENCY_PHANTOM_DELETION_ENABLED=false
PHANTOM_DELETION_CONFIRMATION_TOKEN=
# For production emergency use only:
FORCE_PRODUCTION_PHANTOM_DELETION=false

# ============================================================================
# その他設定
# ============================================================================

# LocalTunnel設定
USE_LOCALTUNNEL=false

# ポジションチェック制限
POSITION_CHECK_LIMIT=100

